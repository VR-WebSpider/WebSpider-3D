# WebSpider 3D Local Development Configuration
# Copy this file to .env and modify as needed.
# .env is gitignored and will not be committed.

# Environment: Prod | Dev | UAT
WEBSPIDER_ENV=Prod

# Backend API URL for this environment
WEBSPIDER_BACKEND_URL=https://api.webspider3d.com

# Frontend URL for this environment (used for SSO login pages)
WEBSPIDER_FRONTEND_URL=https://www.webspider3d.com

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
WEBSPIDER_LOG_LEVEL=INFO
